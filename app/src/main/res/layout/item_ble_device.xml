<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card">

    <TextView
        android:id="@+id/deviceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="WT-WEAROS-1075"
        android:textStyle="bold"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/connectButton" />

    <TextView
        android:id="@+id/deviceMac"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="70:E3:48:AF:09:C9"
        android:textSize="12sp"
        android:alpha="0.8"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/deviceName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/connectButton" />

    <TextView
        android:id="@+id/rssiBadge"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center"
        android:text="-63 dBm"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/bg_chip_neutral"
        app:layout_constraintTop_toBottomOf="@id/deviceMac"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/deviceState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:alpha="0.8"
        android:layout_marginStart="8dp"
        app:layout_constraintBaseline_toBaselineOf="@id/rssiBadge"
        app:layout_constraintStart_toEndOf="@id/rssiBadge"
        app:layout_constraintEnd_toStartOf="@id/connectButton" />

    <Button
        android:id="@+id/connectButton"
        android:layout_width="96dp"
        android:layout_height="40dp"
        android:text="Connect"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>