<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- DEVICE SCREEN -->
    <LinearLayout
        android:id="@+id/deviceScreenRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISCONNECTED"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_chip_neutral"
            android:textColor="@android:color/white"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/scanButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan for WearTAK Devices" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No devices yet. Tap Scan."
            android:paddingTop="10dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/deviceList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="8dp" />

    </LinearLayout>

    <!-- SETTINGS SCREEN -->
    <LinearLayout
        android:id="@+id/settingsScreenRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settingsBackButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Device Settings"
                android:textStyle="bold"
                android:textSize="18sp"
                android:gravity="center_vertical"
                android:paddingLeft="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/settingsDeviceSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/refreshSettingsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Refresh from Watch" />

            <Button
                android:id="@+id/sendSettingsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Send to Watch" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TAK Servers"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/takServerList"
            android:layout_width="match_parent"
            android:layout_height="140dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selected Server"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/takName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Name" />

        <EditText
            android:id="@+id/takAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Address (IP/DNS)" />

        <EditText
            android:id="@+id/takPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="Port" />

        <EditText
            android:id="@+id/takUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Username (if not P12)"
            android:inputType="text" />

        <EditText
            android:id="@+id/takPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password (if not P12)"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/reportInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Report Interval (secs)"
            android:inputType="number"
            android:paddingTop="6dp" />

        <TextView
            android:id="@+id/settingsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:paddingTop="8dp" />

    </LinearLayout>

</FrameLayout>